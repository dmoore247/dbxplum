# FHIR Compliance Testing - Environment Configuration

# Proxy Configuration
PROXY_PORT=3333
TARGET_URL=https://medplum-server-3464092709171785.aws.databricksapps.com

# Medplum Authentication (provided separately)
# Uncomment and set when Medplum credentials are available
# MEDPLUM_TOKEN=<your-medplum-token>
# MEDPLUM_CLIENT_ID=<client-id>
# MEDPLUM_CLIENT_SECRET=<client-secret>

# Inferno Configuration (if running locally)
INFERNO_PORT=4567
FHIR_ENDPOINT=http://localhost:3333/fhir/R4

# Test Configuration
TEST_SUITE=us_core_v7  # Options: fhir_r4, us_core_v5, us_core_v6, us_core_v7
VERBOSE_LOGGING=false
